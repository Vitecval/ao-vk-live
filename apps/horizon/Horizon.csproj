<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <RootNamespace>Horizon</RootNamespace><AssemblyName>Rubi-Ka Horizon</AssemblyName>
    <LangVersion>latest</LangVersion><PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
    <OutputPath>..\..\build\horizon-preview\app\</OutputPath>
    <IntermediateOutputPath>..\..\build\horizon-preview\obj\</IntermediateOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest><AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationIcon>Assets\horizon.ico</ApplicationIcon>
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Xaml"/>
    <Reference Include="WindowsBase"/><Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/>
    <Reference Include="System.Web.Extensions"/><Reference Include="System.IO.Compression"/><Reference Include="System.IO.Compression.FileSystem"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="Microsoft.CSharp"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Net.Http"/>
    <ApplicationDefinition Include="App.xaml"/><Page Include="MainWindow.xaml"/>
    <Compile Include="App.xaml.cs"/><Compile Include="MainWindow.xaml.cs"/><Compile Include="Models.cs"/>
    <Compile Include="SettingsStore.cs"/><Compile Include="SetupService.cs"/><Compile Include="SettingRow.cs"/><Compile Include="SelfTests.cs"/>
    <Compile Include="UpdateService.cs"/><Compile Include="IssueReports.cs"/>
    <Compile Include="UpdateTests.cs"/>
    <Compile Include="SingleInstance.cs"/><Compile Include="InstallDetection.cs"/>
    <Compile Include="SetupActivity.cs"/>
    <Compile Include="KeybindHelp.cs"/>
    <Resource Include="Assets\landscape.png"/><Resource Include="Assets\settings.json"/>
    <Resource Include="Assets\lite-manifest.json.gz"/><Resource Include="Assets\full-manifest.json.gz"/>
    <Resource Include="Assets\engine.json"/><Resource Include="Assets\horizon.ico"/>
    <Resource Include="Assets\graphics-versions.json"/>
    <Resource Include="Assets\core-files.json"/><Resource Include="Assets\temporary-assets.txt.gz"/>
    <EmbeddedResource Include="..\..\tools\install-live.ps1"><LogicalName>Horizon.InstallLive.ps1</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\material-cache.ps1"><LogicalName>Horizon.MaterialCache.ps1</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
