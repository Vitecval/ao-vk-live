<Window x:Class="Horizon.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Horizon" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Rubi-Ka Horizon" Icon="Assets/horizon.ico" Width="1080" Height="740" MinWidth="920" MinHeight="610" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#111D23" FontFamily="Segoe UI" FontSize="13">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><DataTemplate DataType="{x:Type local:Setting}"><local:SettingRow/></DataTemplate></Window.Resources>
 <Border BorderBrush="#34464E" BorderThickness="1"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Image Grid.Column="1" Source="Assets/landscape.png" Stretch="UniformToFill" HorizontalAlignment="Right" Width="1000" Margin="-130,-60,-120,-40" Opacity="0.22" IsHitTestVisible="False"/>
  <Rectangle Grid.Column="1" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EE111D23" Offset="0"/><GradientStop Color="#BB111D23" Offset="0.6"/><GradientStop Color="#F5111D23" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Border Background="#F10E191F" BorderBrush="#2D414A" BorderThickness="0,0,1,0">
   <Grid Margin="16,34,16,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="8,10,0,30"><Canvas Width="32" Height="19" HorizontalAlignment="Left" Margin="0,0,0,12"><Path Stroke="#CEB78E" StrokeThickness="1.3" Data="M 3,14 A 12,12 0 0 1 27,14 M 0,15 L 31,15 M 9,19 L 23,19"/></Canvas><TextBlock Text="Rubi-Ka Horizon" FontSize="18" FontWeight="SemiBold"/></StackPanel>
    <StackPanel x:Name="Navigation" Grid.Row="1"/>
    <StackPanel Grid.Row="3"><TextBlock Text="AO folder" Foreground="#8DA3AD" FontSize="11" Margin="2,0,0,7"/><TextBlock x:Name="SidebarClient" Text="Not selected" FontSize="11" Foreground="#B7C5C9" MaxHeight="48" Margin="2,0,0,10" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Content="Change folder" Click="Browse_Click" Padding="8,7" FontSize="11" Margin="0,0,0,8"/><Button x:Name="LaunchButton" Content="Launch AO" Click="Launch_Click" Padding="8,7" FontSize="11" Margin="0,0,0,20"/><TextBlock x:Name="SidebarVersion" Text="0.7.0" Foreground="#829AA4" FontSize="10" Margin="2,0,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="75"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Width="40" Padding="0" Background="Transparent" BorderBrush="Transparent" Click="Minimize_Click"/><Button Content="□" Width="40" Padding="0" Background="Transparent" BorderBrush="Transparent" Click="Maximize_Click"/><Button Content="×" FontSize="18" Width="40" Padding="0" Background="Transparent" BorderBrush="Transparent" Click="Close_Click"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="24,4,24,0"><TextBlock x:Name="PageTitle" Text="Graphics" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Changes apply while AO is running." Foreground="#9EB2BA" FontSize="12" Margin="0,8,0,0"/></StackPanel>
   <Grid Grid.Row="2" Margin="24,8,24,0">
    <Grid x:Name="GraphicsPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,12,0"><TextBox x:Name="Search" TextChanged="Filter_Changed"/><TextBlock Text="Search settings…" Foreground="#839DA8" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="SectionFilter" Grid.Column="1" SelectionChanged="Section_Changed"/><Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Margin="10,0,0,0" Padding="12,7"/></Grid>
     <Grid Grid.Row="1" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Grid.Column="1" x:Name="PresetPicker"/><Button Grid.Column="2" Content="Apply" Click="Preset_Click" Padding="14,7" Margin="10,0,0,0" ToolTip="Apply the selected preset. Personal options excluded by that preset are kept."/></Grid>
     <ListBox Grid.Row="2" x:Name="SettingsList" Background="#70121F26" BorderBrush="#2F444E" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox>
    </Grid>
    <ScrollViewer x:Name="InstallationPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,10">
     <TextBlock Text="Classic AO folder" FontWeight="SemiBold" Margin="0,0,0,9"/><Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPath" IsReadOnly="True"/><Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="10,0,0,0"/></Grid>
     <TextBlock Text="Edition" FontWeight="SemiBold" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="LiteChoice" GroupName="Edition" IsChecked="True" Content="Lite" Foreground="#DCE6EA" FontSize="13" Margin="0,0,30,0"/><RadioButton x:Name="FullChoice" GroupName="Edition" Content="Full HD" Foreground="#DCE6EA" FontSize="13"/></StackPanel><TextBlock Text="Lite uses the original textures and downloads no texture packs. Full HD adds the artwork and prepared cache: about 28.2 GB on the first download." Foreground="#96AFB9" FontSize="12" Margin="0,10,0,15"/>
     <CheckBox x:Name="MemoryOption" IsChecked="True" Content="Enable 4 GB memory support" ToolTip="Uses the existing checks and backups. Recognized AOSharp/AOPP executable changes are preserved." Margin="0,0,0,18"/>
     <WrapPanel Margin="0,0,0,10"><Button x:Name="InstallButton" Content="Install / update graphics" Click="Install_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Repair" Click="Repair_Click" Margin="0,0,10,8"/><Button Content="Remove graphics" Click="Uninstall_Click" Margin="0,0,10,8"/><Button Content="Reset settings" Click="Reset_Click" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="Close AO and its launcher before changing the installation." Foreground="#96AFB9" FontSize="11" Margin="0,0,0,23"/>
     <TextBlock Text="Download and work folder" FontWeight="SemiBold" Margin="0,0,0,9"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WorkFolder" IsReadOnly="True" FontSize="11"/><Button Grid.Column="1" Content="Choose…" Click="WorkFolder_Click" Margin="10,0,0,0" Padding="12,7"/></Grid><TextBlock Text="Full downloads can resume here. Existing material ZIPs in this folder can be reused." Foreground="#96AFB9" FontSize="11" Margin="0,8,0,21"/>
     <Border BorderBrush="#2E444E" BorderThickness="0,1,0,0" Padding="0,17,0,0"><StackPanel><TextBlock Text="Horizon application" FontWeight="SemiBold"/><TextBlock Text="Add the app to your Windows Start menu without changing AO." Foreground="#96AFB9" FontSize="11" Margin="0,7,0,11"/><Button Content="Install Horizon app" Click="InstallApp_Click" HorizontalAlignment="Left" Padding="12,8"/></StackPanel></Border>
     <TextBlock x:Name="OperationText" Foreground="#AAC0C7" FontSize="12" Margin="0,18,0,0"/><ProgressBar x:Name="SetupProgress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,12,0,0" Foreground="#C6AD83" Background="#293F46"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,10">
     <TextBlock x:Name="CurrentVersionText" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Checks for a new Horizon app and its bundled graphics. Checking does not change AO or download texture packs." Foreground="#9EB2BA" FontSize="12" Margin="0,10,0,20"/>
     <CheckBox x:Name="AutoUpdates" Content="Check for updates when Horizon starts" IsChecked="True" Click="AutoUpdates_Click" Margin="0,0,0,20"/>
     <WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" Margin="0,0,10,10"/><Button x:Name="ApplyUpdateButton" Content="Download update" Style="{StaticResource PrimaryButton}" Click="ApplyUpdate_Click" Visibility="Collapsed" Margin="0,0,0,10"/></WrapPanel>
     <TextBlock x:Name="UpdateMessage" Text="No update check yet." Margin="0,12,0,8"/>
     <TextBlock x:Name="UpdateDetail" Foreground="#9EB2BA" FontSize="12"/>
     <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,16,0,0" Foreground="#C6AD83" Background="#293F46"/>
     <TextBlock Text="You can check and download while playing. Close the selected AO client and its launcher before applying graphics updates. Existing preferences and texture downloads are kept." Foreground="#819DA9" FontSize="11" Margin="0,24,0,0"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ReportPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,12">
     <TextBlock Text="Prepare and review the latest diagnostics, then send them anonymously to dev@asyncstuff.com. No account is needed." Foreground="#9EB2BA" FontSize="12" Margin="0,0,0,16"/>
     <TextBlock Text="Title" Margin="0,0,0,7"/><TextBox x:Name="IssueTitle" Text="Horizon issue" Margin="0,0,0,13" MaxLength="120"/>
     <TextBlock Text="What happened? (optional)" Margin="0,0,0,7"/><TextBox x:Name="IssueDescription" AcceptsReturn="True" TextWrapping="Wrap" Height="88" VerticalScrollBarVisibility="Auto" MaxLength="12000" Margin="0,0,0,13"/>
     <CheckBox x:Name="IncludeLogs" Content="Include the latest renderer log and Horizon diagnostics" IsChecked="True" Margin="0,0,0,10"/>
     <TextBlock Text="Only the selected AO folder is read. Common personal details are removed; review the log excerpts before sending. Reports are emailed privately through asyncstuff.com." Foreground="#819DA9" FontSize="11" Margin="0,0,0,15"/>
     <WrapPanel><Button Content="Prepare report" Click="PrepareReport_Click" Margin="0,0,10,8"/><Button x:Name="SendReportButton" Content="Send report" Click="SendReport_Click" IsEnabled="False" Margin="0,0,10,8"/><Button x:Name="OpenReportButton" Content="Save report ZIP" Click="OpenReport_Click" IsEnabled="False" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock x:Name="ReportMessage" Foreground="#9EB2BA" FontSize="12" Margin="0,7,0,10"/>
     <TextBox x:Name="ReportPreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="240" VerticalScrollBarVisibility="Auto" FontSize="11"/>
    </StackPanel></ScrollViewer>
    <StackPanel x:Name="AboutPage" Visibility="Collapsed"><TextBlock Text="Rubi-Ka Horizon" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersion" Text="0.7.0" Foreground="#A7B9C1" Margin="0,9,0,22"/><TextBlock Text="Graphics and live settings for the classic Anarchy Online client. Built by AsyncStuff on AO-VK. Not affiliated with Funcom." Foreground="#A7B9C1" Margin="0,0,0,18"/><TextBlock Text="The bundled graphics engine includes the Preview 24 r59 fixes. Lite keeps the original textures; Full HD includes artwork and prepared cache." Foreground="#A7B9C1" Margin="0,0,0,18"/><Button Content="Open app data and log" Click="OpenData_Click" HorizontalAlignment="Left" Margin="0,0,0,22"/><TextBlock Text="Software: MIT. Artwork retains its existing licenses and permissions. Closing Horizon leaves AO and your saved settings unchanged." Foreground="#819DA9" FontSize="11"/></StackPanel>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#2C424C" BorderThickness="0,1,0,0" Margin="0,11,0,0"><Grid Margin="24,6,24,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SaveStatus" Text="Choose your AO folder." FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SaveDetail" Text="Your settings stay in the selected AO installation." FontSize="10" Foreground="#819DA6" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel><Button Grid.Column="1" x:Name="UndoButton" Content="Undo" Click="Undo_Click" Padding="12,6" FontSize="11" IsEnabled="False" Margin="12,0,0,0"/></Grid></Border>
  </Grid>
 </Grid></Border>
</Window>
